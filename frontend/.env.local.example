# cp .env.local.example .env.local 후 실제 값 채우기. .env.local 은 .gitignore 대상.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# 포인트 충전: Toss Payments 테스트 결제창을 사용합니다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_your_toss_test_client_key

# 소셜 로그인 — 각 provider 콘솔에 등록한 client id. redirect_uri는 콘솔에도
# "{origin}/oauth/callback/{provider}" (예: http://localhost:3000/oauth/callback/google)
# 로 등록해야 하고, 백엔드 application.yaml의 app.oauth.{provider}.redirect-uri와 값이 같아야 한다.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id
NEXT_PUBLIC_KAKAO_CLIENT_ID=your_kakao_client_id
NEXT_PUBLIC_NAVER_CLIENT_ID=your_naver_client_id
