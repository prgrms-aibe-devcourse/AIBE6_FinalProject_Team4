# cp terraform.tfvars.example terraform.tfvars 후 값 채우기.
# terraform.tfvars는 .gitignore 대상입니다 — 민감값을 커밋하지 마세요.

app_domain       = "api.kiwor.site"
ssh_allowed_cidr = "0.0.0.0/32" # 실제 관리자 IP/32 로 교체

ghcr_owner = "tesalriah" # GitHub 계정 소문자

# 프론트(Vercel) canonical 도메인은 www.kiwor.site (kiwor.site는 Vercel에서 여기로
# 301 리다이렉트되도록 설정돼 있음). 프론트가 window.location.origin을 그대로 써서
# redirect_uri를 만들기 때문에, non-www로 바꾸면 redirect_uri_mismatch로 소셜
# 로그인이 깨진다 — 기본값(variables.tf) 그대로 두거나 바꿀 거면 Vercel의 리다이렉트
# 설정과 반드시 같이 맞출 것.
# google_redirect_uri = "https://www.kiwor.site/oauth/callback/google"
# kakao_redirect_uri  = "https://www.kiwor.site/oauth/callback/kakao"
# naver_redirect_uri  = "https://www.kiwor.site/oauth/callback/naver"

# 실제 메일 발송을 켜려면(기본은 꺼짐 — LoggingEmailSender가 로그에만 찍음):
# mail_enabled  = true
# mail_from     = "no-reply@kiwor.site"
# mail_host     = "smtp.gmail.com"
# mail_port     = 587
# mail_username = "no-reply@kiwor.site"
# (mail_password는 TF_VAR_mail_password로 주입 권장)

# 아래 값은 tfvars 대신 환경변수로 주입하는 걸 권장:
#   export TF_VAR_db_password=...
#   export TF_VAR_jwt_secret=...
#   export TF_VAR_ghcr_token=...
#   export TF_VAR_mail_password=...
#   export TF_VAR_toss_payments_secret_key=...   # Toss 개발자센터 테스트 시크릿 키(test_sk_...) — 필수, 기본값 없음
#   export TF_VAR_openai_api_key=...              # 백엔드 전용 OpenAI API Key

# AI 기능을 활성화할 때 사용하는 모델 ID. 코드에 모델명을 고정하지 않는다.
# openai_text_model   = ""
# openai_vision_model = ""
